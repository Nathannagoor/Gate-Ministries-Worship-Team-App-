rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isTeamLead() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTeamLead == true;
    }
    function isBlankSunday(serviceId) {
      return serviceId.matches('sunday-[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        request.resource.data.date == serviceId[7:17] &&
        request.resource.data.assign.size() == 0 &&
        request.resource.data.avail.size() == 0 &&
        request.resource.data.set.size() == 0;
    }

    // Everyone signed in can read profiles (needed to show names in the
    // team roster, availability grid, feedback, suggestions). Users can
    // create/update their own profile (including their phone number and
    // which positions they can cover), but only a team lead can grant
    // isTeamLead or mark someone else's profile inactive.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
                    && request.resource.data.isTeamLead == false;
      allow update: if signedIn() && (
                      (request.auth.uid == userId &&
                       request.resource.data.isTeamLead == resource.data.isTeamLead)
                      || isTeamLead()
                    );
    }

    // Song arrangements (Practice Arrangements tab): everyone reads, only
    // a team lead edits.
    match /songs/{songId} {
      allow read: if signedIn();
      allow write: if isTeamLead();
    }

    // Song library (title/key/CCLI, used to build set lists): everyone
    // reads, only a team lead edits.
    match /songLibrary/{songId} {
      allow read: if signedIn();
      allow write: if isTeamLead();
    }

    // App-wide config: church name, rehearsal time, roster positions.
    // Single doc, only a team lead edits.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isTeamLead();
    }

    // Services: a specific dated/named event (a Sunday or a special
    // occasion) with its roster assignment, availability, set list and
    // notes. Regular Sundays are auto-created (blank) by any signed-in
    // client under the id sunday-YYYY-MM-DD; only team leads change them.
    match /services/{serviceId} {
      allow read: if signedIn();
      allow create: if isTeamLead() || (signedIn() && isBlankSunday(serviceId));
      allow delete: if isTeamLead();
      allow update: if isTeamLead();
    }

    // Availability: one doc per person per service (id serviceId__userId).
    // Members can only read and write their own answers; team leads can
    // read everyone's and write anyone's.
    match /availability/{docId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isTeamLead());
      allow create, update: if signedIn()
        && docId == request.resource.data.serviceId + '__' + request.resource.data.userId
        && (request.resource.data.userId == request.auth.uid || isTeamLead());
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isTeamLead());
    }

    // Team sheets (chord/lead sheets by song and key): everyone reads, any
    // signed-in member can upload one, and only its uploader or a team lead
    // can edit or delete it.
    match /teamSheets/{sheetId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.uploadedBy == request.auth.uid || isTeamLead());
    }

    // Resources: everyone reads, any signed-in member can add one, only a
    // team lead can edit/delete.
    match /resources/{resourceId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isTeamLead();
    }

    // Feedback: private. Only the author and team leads can read an entry;
    // each person can only post as themselves, and only the author can edit
    // or delete their own feedback.
    match /feedback/{docId} {
      allow read: if signedIn() && (resource.data.authorId == request.auth.uid || isTeamLead());
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Song suggestions: private. Only the submitter and team leads can read
    // one; each person submits as themselves, only a team lead changes status.
    match /suggestions/{docId} {
      allow read: if signedIn() && (resource.data.submittedBy == request.auth.uid || isTeamLead());
      allow create: if signedIn() && request.resource.data.submittedBy == request.auth.uid;
      allow update: if isTeamLead();
    }
  }
}
